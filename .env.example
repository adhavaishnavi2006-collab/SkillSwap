# GEMINI_API_KEY: Optional if AI capabilities are enabled in the future.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SkillSwap Backend & External Services Configuration (Production Deployment)
# ==============================================================================

# Database Connection (MongoDB with Mongoose):
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillswap_college?retryWrites=true&w=majority"

# Authentication Secrets (JWT Token generation):
JWT_SECRET="your_secure_256bit_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Payment Gateway Configuration (Optional - Razorpay / Cashfree / Stripe):
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"

# Email Recovery Service (SMTP / SendGrid for real password recovery emails):
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_username_placeholder"
SMTP_PASS="smtp_password_placeholder"
FROM_EMAIL="noreply@skillswap.edu"
